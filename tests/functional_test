#!/usr/bin/env perl

use strict;
use warnings;
use File::Basename;
use lib dirname (__FILE__);
use TestUtils;
use TestHTTPD;
use File::Temp;

sub proxy {
    my $config = shift;

    exec(@_, '../src/sniproxy', '-f', '-c', $config);
}

sub worker($$$$) {
    my ($hostname, $path, $port, $requests) = @_;

    for (my $i = 0; $i < $requests; $i++) {
        system('curl',
                '-s', '-S', '--fail',
                '-H', "Host: $hostname",
                '-o', '/dev/null',
                "http://localhost:$port/$path");

        if ($? == -1) {
            die "failed to execute: $!\n";
        } elsif ($? & 127) {
            printf STDERR "child died with signal %d, %s coredump\n", ($? & 127), ($? & 128) ? 'with' : 'without';
            exit 255;
        } elsif ($? >> 8) {
            exit $? >> 8;
        }
    }
    # Success
    exit 0;
}

sub connection_dump_files() {
    # connection.c writes dumps as <secure-temp-dir>/connections-XXXXXX.
    # The secure temp dir is whichever of these the daemon chose at its
    # first dump (in priority order): $XDG_RUNTIME_DIR/sniproxy,
    # /var/run/sniproxy, or /tmp/sniproxy-<uid>. The test gives it an
    # XDG_RUNTIME_DIR of its own, which OpenBSD does not use, so that
    # only there are the dumps of other runs seen.
    my @candidates = ("$ENV{XDG_RUNTIME_DIR}/sniproxy");
    if ($^O eq 'openbsd') {
        push @candidates, '/var/run/sniproxy';
        # The dump is written by the user sniproxy runs as, not by us
        my ($uid) = test_ids();
        push @candidates, "/tmp/sniproxy-$uid";
    }

    my %files;
    foreach my $dir (@candidates) {
        opendir(my $dh, $dir) or next;
        foreach my $entry (readdir($dh)) {
            $files{"$dir/$entry"} = 1
                if $entry =~ /^connections-[0-9A-Za-z]{6,}$/;
        }
        closedir($dh);
    }

    return \%files;
}

# Asks for dumps until it is sent SIGTERM, then finishes the dump it
# asked for, so that none is left behind
sub dump_connections_worker($) {
    my ($proxy_pid) = @_;
    my $stop = 0;
    local $SIG{TERM} = sub { $stop = 1; };

    my $existing_dump_files = connection_dump_files();

    while (!$stop && kill('USR1', $proxy_pid)) {
        my @new_dump_files;
        for (my $tries = 0; $tries < 200 && !@new_dump_files; $tries++) {
            select(undef, undef, undef, 0.05);
            @new_dump_files = grep { !$existing_dump_files->{$_} }
                    keys %{connection_dump_files()};
        }

        die "sniproxy didn't dump connections" unless @new_dump_files;

        foreach my $dump_file (@new_dump_files) {
            unlink $dump_file;
        }
    }
    exit 0;
}

sub main {
    my $proxy_port = $ENV{SNI_PROXY_PORT} || find_free_port();
    my $httpd_port = $ENV{TEST_HTTPD_PORT} || find_free_port();
    my $workers = $ENV{WORKERS} || 10;
    my $iterations = $ENV{ITERATIONS} || 10;
    my $local_httpd = $ENV{LOCAL_HTTPD_PORT};

    # The connection dumps go to a directory of the test's own, which
    # sniproxy only uses when it belongs to the user it runs as
    my $runtime_dir = File::Temp::tempdir(CLEANUP => 1);
    if ($> == 0) {
        my ($uid, $gid) = test_ids();
        chown($uid, $gid, $runtime_dir) or die "chown $runtime_dir: $!\n";
    }
    $ENV{XDG_RUNTIME_DIR} = $runtime_dir;

    my $config = make_config($proxy_port, $local_httpd || $httpd_port);
    my $proxy_pid = start_child('server', \&proxy, $config, @ARGV);
    my $httpd_pid = start_child('server', \&TestHTTPD::httpd, port => $httpd_port) unless $local_httpd;

    # Wait for proxy to load and parse config
    wait_for_port(port => $httpd_port);
    wait_for_port(port => $proxy_port);

    my $dump_pid = start_child('dump-connections-worker',
            \&dump_connections_worker, $proxy_pid);

    for (my $i = 0; $i < $workers; $i++) {
        start_child('worker', \&worker, 'localhost', '', $proxy_port, $iterations);
    }

    # Wait for all our children to finish
    wait_for_type('worker');

    # Give the proxy a second to flush buffers and close server connections
    sleep 1;

    # Let the dump worker remove its last dump before the proxy stops
    kill 15, $dump_pid;
    wait_for_type('dump-connections-worker');

    # For troubleshooting connections stuck in CLOSE_WAIT state
    #kill 10, $proxy_pid;
    #system("netstat -ptn | grep $proxy_pid\/sniproxy");

    # For troubleshooting 100% CPU usage
    #system("top -n 1 -p $proxy_pid -b");

    # Orderly shutdown of the server
    kill 15, $proxy_pid;
    kill 15, $httpd_pid unless $local_httpd;
    sleep 1;

    # Delete our test configuration
    unlink($config);

    # Kill off any remaining children
    reap_children();
}

main();
