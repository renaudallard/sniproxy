#!/usr/bin/env perl

use strict;
use warnings;
use File::Basename;
use lib dirname (__FILE__);
use TestUtils;
use TestHTTPD;
use File::Temp;
use IO::Socket::INET;

sub proxy {
    my $config = shift;

    exec(@_, '../src/sniproxy', '-f', '-c', $config);
}

sub make_accept_config($$) {
    my $proxy_port = shift;
    my $httpd_port = shift;

    my ($fh, $filename) = File::Temp::tempfile();
    my $logfile = log_tempfile();

    print $fh <<END;
user @{[test_user()]}
group @{[test_group()]}
per_ip_connection_rate 0

listen 127.0.0.1 $proxy_port {
    proto http
    proxy_protocol yes
    access_log $logfile
}

table {
    localhost 127.0.0.1:$httpd_port
}
END

    close ($fh);

    return $filename;
}

# Send a PROXY header followed by a request, and return the status the
# client got, or 0 when the connection was closed without an answer
sub status_after($$) {
    my $port = shift;
    my $header = shift;

    my $socket = IO::Socket::INET->new(PeerAddr => '127.0.0.1',
                                       PeerPort => $port,
                                       Proto => "tcp",
                                       Type => SOCK_STREAM)
        or die "couldn't connect $!";

    $socket->send($header . "GET / HTTP/1.0\r\nHost: localhost\r\n\r\n");

    my $buffer = '';
    my $data;
    while (defined $socket->recv($data, 16384) && length $data) {
        $buffer .= $data;
    }
    $socket->close();

    return $buffer =~ m/\AHTTP\/1\.[01] (\d{3})/ ? $1 : 0;
}

# A v2 PROXY command for the given family and transport byte
sub proxy_v2($$) {
    my $family = shift;
    my $addresses = shift;

    return "\r\n\r\n\x00\r\nQUIT\n" . pack('CCn', 0x21, $family,
            length $addresses) . $addresses;
}

sub main {
    my $proxy_port = $ENV{SNI_PROXY_PORT} || find_free_port();
    my $httpd_port = $ENV{TEST_HTTPD_PORT} || find_free_port();

    my $config = make_accept_config($proxy_port, $httpd_port);
    my $proxy_pid = start_child('server', \&proxy, $config, @ARGV);
    my $httpd_pid = start_child('server', \&TestHTTPD::httpd, port => $httpd_port);

    wait_for_port(port => $httpd_port);
    wait_for_port(port => $proxy_port);

    # Header, whether the request must reach the backend
    my @cases = (
        [ "PROXY TCP4 192.0.2.1 192.0.2.2 1234 80\r\n", 1 ],
        [ "PROXY TCP6 2001:db8::1 2001:db8::2 1234 80\r\n", 1 ],
        [ "PROXY UNKNOWN\r\n", 1 ],
        [ "PROXY  TCP4 192.0.2.1 192.0.2.2 1234 80\r\n", 0 ],
        [ "PROXY TCP4 192.0.2.1  192.0.2.2 1234 80\r\n", 0 ],
        [ "PROXY TCP4\t192.0.2.1 192.0.2.2 1234 80\r\n", 0 ],
        [ "PROXY TCP4 192.0.2.1 192.0.2.2 1234 80 \r\n", 0 ],
        [ proxy_v2(0x11, "\xc0\x00\x02\x01\xc0\x00\x02\x02\x04\xd2\x00\x50"), 1 ],
        [ proxy_v2(0x11, "\xc0\x00\x02\x01"), 0 ],
        [ proxy_v2(0x31, "\x00" x 216), 1 ],
        [ proxy_v2(0x31, "\x00" x 215), 0 ],
        [ proxy_v2(0x31, ""), 0 ],
    );

    my $failed = 0;
    for my $case (@cases) {
        my ($header, $accepted) = @$case;
        my $status = status_after($proxy_port, $header);
        if (($status == 200) != $accepted) {
            (my $shown = substr($header, 0, 48)) =~ s/([^ -~])/sprintf("\\x%02x", ord($1))/ge;
            print STDERR "PROXY header $shown: got status $status, expected " .
                    ($accepted ? "200" : "a refusal") . "\n";
            $failed = 1;
        }
    }

    kill 15, $proxy_pid;
    kill 15, $httpd_pid;
    sleep 1;

    unlink($config);

    reap_children();

    exit $failed;
}

main();
