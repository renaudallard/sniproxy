#!/usr/bin/env perl

use strict;
use warnings;
use File::Basename;
use lib dirname (__FILE__);
use TestUtils;
use IO::Socket;
use Socket;
use POSIX qw(:sys_wait_h);
use File::Temp;

sub proxy {
    my $config = shift;
    my $log = shift;

    open(STDOUT, '>>', $log) or die "open $log: $!";
    open(STDERR, '>&', \*STDOUT) or die "dup: $!";
    exec(@_, '../src/sniproxy', '-f', '-c', $config);
}

# Print what the proxy logged, for check_output.sh to look at, and count
# its lines: a proxy that keeps a reset client open retries the send and
# logs its failure without end, which no exit status shows
sub proxy_log_lines($) {
    my $log = shift;

    open(my $fh, '<', $log) or die "open $log: $!";
    my @lines = <$fh>;
    close($fh);
    unlink($log);

    if (@lines > 300) {
        print @lines[0 .. 99];
        printf "... %d lines left out ...\n", @lines - 200;
        print @lines[-100 .. -1];
    } else {
        print @lines;
    }

    return scalar(@lines);
}

sub simple_server($) {
    my $port = shift;

    my $server = IO::Socket::INET->new(LocalPort => $port,
                                       Type => SOCK_STREAM,
                                       Reuse => 1,
                                       Listen => 10)
        or die "listen: $!";

    while (my $client = $server->accept()) {
        my $pid = fork();
        next if $pid; # Parent
        die "fork: $!" unless defined $pid;

        $server->close();

        while (my $line = <$client>) {
            last if $line eq "\r\n"; # End of headers
        }

        $client->send("HTTP/1.1 200 OK\r\n" .
                      "Content-Type: text/plain\r\n" .
                      "Content-Length: 16777216\r\n" .
                      "\r\n");

        # Send a bunch of data (more that will be buffered by the kernel
        for (my $i = 0; $i < 16384; $i++) {
            $client->send('x' x 16384);
        }
        $client->close();
        exit;
    }
    $server->close();

    # Wait for children
    1 until (-1 == waitpid(-1, WNOHANG));

    exit(0);
}

sub bad_client($) {
    my $port = shift;

    my $socket = IO::Socket::INET->new(PeerAddr => '127.0.0.1',
                                       PeerPort => $port,
                                       Proto => "tcp",
                                       Type => SOCK_STREAM)
        or die "couldn't connect $!";

    $socket->send("GET / HTTP/1.1\r\n" .
                  "UserAgent: bad_client/0.1\r\n" .
                  "Host: localhost:$port\r\n" .
                  "Accept: */*\r\n" .
                  "\r\n");

    my $buffer;
    $socket->recv($buffer, 16384);

    # Die while the server is still sending: the kernel sends a reset
    # for the unread data, so the proxy has to handle a connection
    # reset in the middle of the transfer, not a client that vanished
    # before its request.
    kill 9, $$;
}

sub main {
    my $proxy_port = $ENV{SNI_PROXY_PORT} || find_free_port();
    my $httpd_port = $ENV{TEST_HTTPD_PORT} || find_free_port();

    my $config = make_config($proxy_port, $httpd_port);
    my ($log_fh, $proxy_log) = File::Temp::tempfile();
    close($log_fh);
    my $proxy_pid = start_child('sniproxy', \&proxy, $config, $proxy_log,
            @ARGV);
    my $httpd_pid = start_child('server', \&simple_server, $httpd_port);

    # Wait for proxy to load and parse config
    wait_for_port(port => $httpd_port);
    wait_for_port(port => $proxy_port);

    for (my $i = 0; $i < 10; $i++) {
        start_child('worker', \&bad_client, $proxy_port);
    }

    # Wait for all our children to finish
    wait_for_type('worker');

    # Give the proxy a second to flush buffers and close server connections
    sleep 1;

    # For troubleshooting connections stuck in CLOSE_WAIT state
    #kill 10, $proxy_pid;
    #system("netstat -ptn | grep $proxy_pid\/sniproxy");

    # For troubleshooting 100% CPU usage
    #system("top -n 1 -p $proxy_pid -b");

    # Orderly shutdown of the server
    kill 15, $proxy_pid;
    kill 15, $httpd_pid;
    sleep 1;

    # Delete our test configuration
    unlink($config);

    # All of its output, what it logs while stopping included
    wait_for_type('sniproxy');
    my $lines = proxy_log_lines($proxy_log);

    # Kill off any remaining children
    reap_children();

    if ($lines > 200) {
        print "The proxy logged $lines lines for 10 reset clients\n";
        exit 1;
    }
}

main();
