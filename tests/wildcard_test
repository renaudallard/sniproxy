#!/usr/bin/env perl

use strict;
use warnings;
use File::Basename;
use lib dirname (__FILE__);
use TestUtils;
use TestHTTPD;
use File::Temp;

# Hostnames the clients ask for, which the '*' entry looks up
my $test_domains = [
    'localhost',
    'LOCALHOST',
    'localhost.'
];

# A '*' table entry, which connects to the hostname the client asked for. The backend is looked up through the resolver, which finds
# localhost in /etc/hosts, so no network access is needed.
sub make_wildcard_config($$) {
    my ($proxy_port, $httpd_port) = @_;

    my ($fh, $filename) = File::Temp::tempfile();

    # Write out a test config file
    print $fh <<END;
# Minimal test configuration

user @{[test_user()]}
group @{[test_group()]}

resolver {
    mode ipv4_only
}

listen 127.0.0.1 $proxy_port {
    proto http
}

table {
    .* *:$httpd_port
}
END

    close ($fh);

    return $filename;
}

sub proxy {
    my $config = shift;

    exec(@_, '../src/sniproxy', '-f', '-c', $config);
}

sub request($$) {
    my ($hostname, $port) = @_;

    system('curl',
            '-s', '-S', '--fail',
            '-H', "Host: $hostname",
            '-o', '/dev/null',
            "http://localhost:$port/");
    if ($? == -1) {
        die "failed to execute: $!\n";
    } elsif ($? & 127) {
        printf STDERR "child died with signal %d, %s coredump\n", ($? & 127), ($? & 128) ? 'with' : 'without';
        exit 255;
    }
    return $? >> 8;
}

sub worker($$) {
    my ($port, $requests) = @_;

    for (my $i = 0; $i < $requests; $i++) {
        my $hostname = $test_domains->[$i % scalar(@$test_domains)];
        my $status = request($hostname, $port);
        exit $status if $status;
    }
    # Success
    exit 0;
}

sub main {
    my $proxy_port = $ENV{SNI_PROXY_PORT} || find_free_port();
    my $httpd_port = $ENV{TEST_HTTPD_PORT} || find_free_port();
    my $workers = $ENV{WORKERS} || 3;
    my $iterations = $ENV{ITERATIONS} || 3;

    my $config = make_wildcard_config($proxy_port, $httpd_port);
    my $proxy_pid = start_child('server', \&proxy, $config, @ARGV);
    my $httpd_pid = start_child('server', \&TestHTTPD::httpd,
            ip => '127.0.0.1', port => $httpd_port);

    # Wait for proxy to load and parse config
    wait_for_port(port => $httpd_port);
    wait_for_port(port => $proxy_port);

    # Address literals are refused as a '*' target, including forms that
    # only the resolver would read as one
    foreach my $literal ('127.0.0.1', '127.0.0.01', '2130706433') {
        die "'*' entry accepted the address literal $literal\n"
            if request($literal, $proxy_port) == 0;
    }

    for (my $i = 0; $i < $workers; $i++) {
        start_child('worker', \&worker, $proxy_port, $iterations);
    }

    # Wait for all our children to finish
    wait_for_type('worker');

    # Orderly shutdown of the server
    kill 15, $proxy_pid;
    kill 15, $httpd_pid;
    sleep 1;

    # Delete our test configuration
    unlink($config);

    # Kill off any remaining children
    reap_children();
}

main();
