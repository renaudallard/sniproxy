#!/sbin/openrc-run
#
# Enable with: rc-update add sniproxy
#
# Settings may be overridden in /etc/conf.d/sniproxy:
#
# SNIPROXY_CONFIG (path):	Configuration file.
#				Default: "/etc/sniproxy.conf"
# SNIPROXY_OPTS (str):		Extra options.
#				Default: "-g", which an empty value turns off.
#
# sniproxy starts as root, binds its listeners and drops to the user named
# in the configuration. -g lets that user read the configuration again on
# reload, which needs it to be 0640 and owned by that user's group.

name="sniproxy"
description="Proxy routing TLS, DTLS, HTTP, XMPP and Minecraft by hostname"

: ${SNIPROXY_CONFIG:="/etc/sniproxy.conf"}
: ${SNIPROXY_OPTS="-g"}

command="/usr/sbin/sniproxy"
command_args="-f -c $SNIPROXY_CONFIG $SNIPROXY_OPTS"
command_background=true
# A start refused before the error log is open, as for an unknown user,
# is reported on standard error, which a background command would lose.
# Every start also writes notices there while it reads the configuration,
# so the priority is the one most of them have.
error_logger="logger -t $RC_SVCNAME -p daemon.notice"
pidfile="/run/$RC_SVCNAME.pid"
required_files="$SNIPROXY_CONFIG"
extra_started_commands="reload"

depend() {
	need net
	use dns logger
	after firewall
}

reload() {
	ebegin "Reloading $name"
	start-stop-daemon --signal HUP --pidfile "$pidfile"
	eend $?
}
