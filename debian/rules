#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure

override_dh_auto_test:

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start

# sniproxy refuses a config readable by others; 0640 root:daemon lets the
# daemon user it drops to read it again on reload (with -g). dh_fixperms
# would reset both of these to root and 0644/0755.
override_dh_fixperms:
	dh_fixperms -Xetc/sniproxy.conf -Xvar/log/sniproxy

execute_after_dh_install:
	install -D -m 640 -g daemon scripts/sniproxy.conf debian/sniproxy/etc/sniproxy.conf
	install -D -m 644 scripts/sniproxy.logrotate debian/sniproxy/etc/logrotate.d/sniproxy.conf
	install -d -m 750 -o daemon -g adm debian/sniproxy/var/log/sniproxy
