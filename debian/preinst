#!/bin/sh
set -e

# Up to 0.24.1 the rc links started the init script and ENABLED=0 in
# /etc/default/sniproxy kept it from running. The links now decide, so
# the postinst turns that setting into disabled links. It has to be read
# here, before the new default file replaces it. Leave the links alone
# under systemd when the unit is enabled, since update-rc.d would
# disable the unit as well.
case "$1" in
install|upgrade)
	if [ -z "$DPKG_ROOT" ] && [ -n "$2" ] &&
	    dpkg --compare-versions "$2" lt 0.24.2~ &&
	    [ -f /etc/init.d/sniproxy ] && [ -r /etc/default/sniproxy ] &&
	    (ENABLED=1; . /etc/default/sniproxy; [ "$ENABLED" = 0 ]) &&
	    { [ ! -d /run/systemd/system ] ||
	    ! systemctl --quiet is-enabled sniproxy.service 2>/dev/null; }
	then
		mkdir -p /var/lib/sniproxy
		: > /var/lib/sniproxy/disable-initscript
	fi
	;;
esac

#DEBHELPER#

exit 0
