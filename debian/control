Build-Depends: cdbs, debhelper (>= 12.8), dh-autoreconf, autotools-dev, gettext, pkg-config, libev-dev (>= 4.0), libpcre2-dev, libc-ares-dev, libssl-dev, libbsd-dev, libseccomp-dev
Standards-Version: 3.9.5
Rules-Requires-Root: binary-targets
Vcs-Git: https://github.com/renaudallard/sniproxy.git
Vcs-Browser: https://github.com/renaudallard/sniproxy

Package: sniproxy
Architecture: any
Depends: ${shlibs:Depends}, ${misc:Depends}
Recommends: logrotate
Description: Transparent TLS and HTTP layer 4 proxy with SNI support
 Proxies incoming HTTP and TLS connections based on the hostname contained in
 the initial request of the TCP session. This enables HTTPS name-based virtual
 hosting to separate backend servers without installing the private key on the
 proxy machine.
