# Defaults for sniproxy initscript

# This file has two functions:
# 1) to completely disable starting sniproxy,
# 2) to select an alternative config file
#    by setting DAEMON_ARGS to -c <file>

# Additional options that are passed to the Daemon. Keep -g: the config is
# 0640 root:daemon so that the daemon user can read it again on reload.
#DAEMON_ARGS="-g -c /etc/sniproxy.conf"

# The systemd unit reads SNIPROXY_CONFIG and SNIPROXY_OPTS instead
# (defaults /etc/sniproxy.conf and -g).
#SNIPROXY_OPTS="-g"

# Whether or not to run the sniproxy daemon; set to 0 to disable, 1 to enable.
ENABLED=0

